{
  "name": "archive-gallery",
  "private": true,
  "version": "1.1.77",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check": "tsc --noEmit",
    "build:cli": "cargo build --manifest-path src-tauri/Cargo.toml --release --bin galleryctl",
    "build:bundle": "npm run tauri build -- --bundles nsis",
    "release": "node scripts/release.mjs",
    "release:minor": "node scripts/release.mjs --minor",
    "release:major": "node scripts/release.mjs --major",
    "export-tags": "node scripts/export-tags.mjs",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
