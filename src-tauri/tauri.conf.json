{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "画匣",
  "version": "1.0.0",
  "identifier": "com.archivegallery.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run build:cli",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "画匣 · 本地画廊",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "本地离线的 ZIP / CBZ 画集画廊",
    "longDescription": "画匣把 ZIP / CBZ 图集统一导入本地库目录，支持封面总览、评分、标签、收藏夹、组合筛选与内置阅读器，全程不联网。",
    "publisher": "Archive Gallery",
    "copyright": "© 2026 Archive Gallery",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  }
}
